     \"type\": \"string\",\n                  \"allowedValues\": [\n                    \"new\"\n                  ]\n                }\n              },\n              \"metadata\": {\n                \"__bicep_imported_from!\": {\n                  \"sourceTemplate\": \"types.bicep\"\n                }\n              }\n            },\n            \"_1.storagePrivateDnsZone_none_t\": {\n              \"type\": \"object\",\n              \"properties\": {\n                \"type\": {\n                  \"type\": \"string\",\n                  \"allowedValues\": [\n                    \"none\"\n                  ]\n                }\n              },\n              \"metadata\": {\n                \"__bicep_imported_from!\": {\n                  \"sourceTemplate\": \"types.bicep\"\n                }\n              }\n            },\n            \"_1.storagePrivateDnsZone_t\": {\n              \"type\": \"object\",\n              \"discriminator\": {\n                \"propertyName\": \"type\",\n                \"mapping\": {\n                  \"new\": {\n                    \"$ref\": \"#/definitions/_1.storagePrivateDnsZone_new_t\"\n                  },\n                  \"existing\": {\n                    \"$ref\": \"#/definitions/_1.storagePrivateDnsZone_existing_t\"\n                  },\n                  \"none\": {\n                    \"$ref\": \"#/definitions/_1.storagePrivateDnsZone_none_t\"\n                  }\n                }\n              },\n              \"metadata\": {\n                \"__bicep_imported_from!\": {\n                  \"sourceTemplate\": \"types.bicep\"\n                }\n              }\n            },\n            \"_1.storedKey_t\": {\n              \"type\": \"object\",\n              \"properties\": {\n                \"id\": {\n                  \"type\": \"string\"\n                },\n                \"location\": {\n                  \"type\": \"string\"\n                },\n                \"name\": {\n                  \"type\": \"string\"\n                }\n              },\n              \"metadata\": {\n                \"__bicep_imported_from!\": {\n                  \"sourceTemplate\": \"types.bicep\"\n                }\n              }\n            },\n            \"_1.subnets_t\": {\n              \"type\": \"object\",\n              \"properties\": {\n                \"cyclecloud\": {\n                  \"$ref\": \"#/definitions/_1.rsc_t\"\n                },\n                \"compute\": {\n                  \"$ref\": \"#/definitions/_1.rsc_t\"\n                },\n                \"home\": {\n                  \"$ref\": \"#/definitions/_1.rsc_t\",\n                  \"nullable\": true\n                },\n                \"additional\": {\n                  \"$ref\": \"#/definitions/_1.rsc_t\",\n                  \"nullable\": true\n                },\n                \"bastion\": {\n                  \"$ref\": \"#/definitions/_1.rsc_t\",\n                  \"nullable\": true\n                },\n                \"database\": {\n                  \"$ref\": \"#/definitions/_1.rsc_t\",\n                  \"nullable\": true\n                }\n              },\n              \"metadata\": {\n                \"__bicep_imported_from!\": {\n                  \"sourceTemplate\": \"types.bicep\"\n                }\n              }\n            },\n            \"_1.tags_t\": {\n              \"type\": \"object\",\n              \"properties\": {},\n              \"additionalProperties\": {\n                \"type\": \"string\"\n              },\n              \"metadata\": {\n                \"__bicep_imported_from!\": {\n                  \"sourceTemplate\": \"types.bicep\"\n                }\n              }\n            },\n            \"_1.vnet_autocreate_t\": {\n              \"type\": \"object\",\n              \"properties\": {\n                \"type\": {\n                  \"type\": \"string\",\n                  \"allowedValues\": [\n                    \"new\"\n    